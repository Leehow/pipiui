      }
    },
    {
      "schemaVersion": 1,
      "event": "cancel",
      "planId": "host-contract-plan",
      "at": "2026-08-10T00:00:03.000Z"
    }
  ],
  "responses": [
    {
      "schemaVersion": 1,
      "ok": true,
      "applied": true,
      "revision": 7
