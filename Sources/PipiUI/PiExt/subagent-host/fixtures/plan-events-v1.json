  },
  "events": [
    {
      "schemaVersion": 1,
      "event": "publish",
      "at": "2026-08-10T00:00:00.000Z",
      "plan": {
        "id": "host-contract-plan",
        "title": "Portable host contract",
        "summary": "Freeze contracts before moving hosts.",
        "tasks": [
          { "id": "contract", "title": "Define v1 contracts", "state": "pending" },
          { "id": "adapter", "title": "Build Node adapter", "state": "pending", "detail": "" }
        ]
      }
    },
    {
      "schemaVersion": 1,
      "event": "approve",
      "planId": "host-contract-plan",
      "at": "2026-08-10T00:00:01.000Z"
    },
    {
      "schemaVersion": 1,
      "event": "task_update",
      "planId": "host-contract-plan",
      "at": "2026-08-10T00:00:02.000Z",
      "task": {
        "id": "contract",
        "state": "completed",
