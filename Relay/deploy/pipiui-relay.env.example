PIPIUI_RELAY_HOST=127.0.0.1
PIPIUI_RELAY_PORT=8787
PIPIUI_PUBLIC_ORIGIN=https://pipi.aichattrpg.com
# Dedicated in-memory capability tunnel; no account, OTP, device registration,
# database, TURN, or HTTP command API.
PIPIUI_TUNNEL_URL=wss://signal.aichattrpg.com/tunnel/ws
# Optional shared browser UI (packages/ui/dist/browser). Missing dir uses fallback HTML.
# PIPIUI_BROWSER_UI_DIR=/opt/pipiui-relay/browser-ui
