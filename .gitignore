# Dependency trees at any depth. A historical Electron-only rule set once left
# deep node_modules tracked-able, and a bulk `git add` of a runtime tree
# swept 31766 files into a commit.
node_modules/

# Vendored Firecrawl pdf-inspector (local-first PDF runtime)
!Electron/resources/runtime/pdf-inspector/
!Electron/resources/runtime/pdf-inspector/**
!Electron/resources/runtime/pdf-inspector/node_modules/
!Electron/resources/runtime/pdf-inspector/node_modules/**
# Vendored Firecrawl anydoc (local-first any-document runtime)
!Electron/resources/runtime/anydoc/
!Electron/resources/runtime/anydoc/**
!Electron/resources/runtime/anydoc/node_modules/
!Electron/resources/runtime/anydoc/node_modules/**

# TypeScript incremental build state
*.tsbuildinfo

# Electron workspace outputs
Electron/**/dist/
!Electron/resources/runtime/extensions/hello-pipiui/app/dist/
!Electron/resources/runtime/extensions/hello-pipiui/app/dist/**
# Bundled manifest extensions ship their compiled halves (synced from the workspace package)
!Electron/resources/runtime/extensions/grok-build-oauth/
!Electron/resources/runtime/extensions/grok-build-oauth/**
Electron/**/out/

# file-viewer vite-plugin copies (regenerated on build; manifest has machine paths)
