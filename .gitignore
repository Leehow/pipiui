.tmp/
build/
Sources.bak-20260723-104538/
.DS_Store

# local pi session attachments / scratch
.pi/

# ZCode session/plan cache
.zcode/

# Local coding-agent state and execution records
.qoder/
.superpowers/sdd/

# Local git worktrees
.worktrees/

# Dependency trees at any depth. A historical Electron-only rule set once left
# deep node_modules tracked-able, and a bulk `git add` of a runtime tree
# swept 31766 files into a commit.
node_modules/

# Vendored Firecrawl pdf-inspector (local-first PDF parser), owned by the
# pipiui-pdf-extension workspace package (manifest runtimeAssets vendor/pdf-inspector)
!Electron/packages/pipiui-pdf-extension/vendor/pdf-inspector/
!Electron/packages/pipiui-pdf-extension/vendor/pdf-inspector/**
!Electron/packages/pipiui-pdf-extension/vendor/pdf-inspector/node_modules/
!Electron/packages/pipiui-pdf-extension/vendor/pdf-inspector/node_modules/**
# npm-regenerated shims; also filtered out of packaged resources
Electron/packages/pipiui-pdf-extension/vendor/pdf-inspector/node_modules/.bin/
# Vendored Firecrawl anydoc (local-first any-document runtime)
!Electron/resources/runtime/anydoc/
!Electron/resources/runtime/anydoc/**
!Electron/resources/runtime/anydoc/node_modules/
!Electron/resources/runtime/anydoc/node_modules/**

# TypeScript incremental build state
*.tsbuildinfo

# Electron workspace outputs
Electron/**/dist/
!Electron/resources/runtime/extensions/hello-pipiui/app/dist/
!Electron/resources/runtime/extensions/hello-pipiui/app/dist/**
# Bundled manifest extensions ship their compiled halves (synced from the workspace package)
!Electron/resources/runtime/extensions/grok-build-oauth/
!Electron/resources/runtime/extensions/grok-build-oauth/**
!Electron/resources/runtime/extensions/deepseek/
!Electron/resources/runtime/extensions/deepseek/**
# Bundled manifest extension runtime bundles (compiled halves synced from the
# workspace packages by scripts/sync-bundled-extension.mjs)
!Electron/resources/runtime/extensions/office-extension/
!Electron/resources/runtime/extensions/office-extension/**
!Electron/resources/runtime/extensions/pipiui-headroom/
!Electron/resources/runtime/extensions/pipiui-headroom/**
# Bundled manifest extension runtime bundle (generated by
# scripts/sync-bundled-extension.mjs from Electron/packages/pipiui-pdf-extension,
# including its owned vendored parser dependency tree)
!Electron/resources/runtime/extensions/pdf-extension/
!Electron/resources/runtime/extensions/pdf-extension/**
!Electron/resources/runtime/extensions/pdf-extension/vendor/pdf-inspector/node_modules/
!Electron/resources/runtime/extensions/pdf-extension/vendor/pdf-inspector/node_modules/**
Electron/resources/runtime/extensions/pdf-extension/vendor/pdf-inspector/node_modules/.bin/
Electron/**/out/

# file-viewer vite-plugin copies (regenerated on build; manifest has machine paths)
Electron/**/public/file-viewer/
Electron/apps/electron/src/renderer/public/file-viewer/

# Local live-acceptance shots
tmp-screenshots/
/pipiui-*-acceptance*.png

# Local Electron checkout runtime (models/settings and live session JSONL)
Electron/agent/
Electron/sessions/
