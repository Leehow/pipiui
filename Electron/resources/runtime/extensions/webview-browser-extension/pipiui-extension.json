  "permissions": [
    "browser.session"
  ],
  "update": {
    "channel": "stable",
    "signature": "ed25519"
  },
  "updateComponents": [
    {
      "id": "webview-browser-extension",
      "name": "PipiUI WebView Browser",
      "version": "0.1.0",
      "source": {
        "type": "githubReleases",
        "owner": "Leehow",
        "repo": "pipiui"
      },
      "upstream": "https://github.com/Leehow/pipiui"
    }
  ]
}
