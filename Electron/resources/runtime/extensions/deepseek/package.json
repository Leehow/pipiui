{
  "name": "@pipiui/deepseek-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent DeepSeek Extended Responses provider + hosted web_search (does not merge into reserved deepseek)",
  "exports": {
    "./package.json": "./package.json",
    "./agent/provider": "./agent/dist/provider.js",
    "./agent/host": "./agent/dist/host.js",
    "./agent/models": "./agent/dist/models.js"
  },
  "scripts": {
    "build": "tsc -p agent/tsconfig.json && esbuild app/usage-panel.tsx --bundle --format=esm --outfile=app/dist/usage-panel.js --jsx=automatic",
    "postbuild": "node scripts/postbuild.mjs",
    "test": "vitest run",
    "clean": "rm -rf agent/dist app/dist"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@pipiui/extension-api": "*",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@pipiui/extension-api": "*"
  }
}
