{
  "id": "code-retrieval",
  "name": "Code Retrieval",
  "version": "1.0.0",
  "agent": {
    "extension": "agent/dist/index.js"
  },
  "app": {
    "settings": {
      "scope": "project",
      "schema": {
        "type": "object",
        "properties": {
          "ext.code-retrieval.exactProvider": {
            "type": "string",
            "enum": ["auto", "rg", "tantivy"],
            "default": "auto",
            "title": "精确索引",
            "description": "auto=优先 Tantivy、不可用时诚实回退 rg；rg=强制 rg；tantivy=请求 Tantivy，失败回退 rg 并标注降级"
          },
          "ext.code-retrieval.tokenBudget": {
            "type": "number",
            "default": 4000,
            "title": "默认 token 预算"
          },
          "ext.code-retrieval.excludeGlobs": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "title": "排除 glob"
          }
        }
      }
    },
    "ui": {
      "panels": [],
      "toolRenderers": [
        { "tool": "code_search", "entry": "app/dist/search-card.js" },
        { "tool": "repo_map", "entry": "app/dist/map-card.js" }
      ],
      "slashCommands": [{ "name": "reindex", "description": "重建本项目代码索引" }]
    }
  },
  "capabilities": ["settings.read", "bridge.emit", "invoke.agent", "stream.render"],
  "settingsVersion": 1,
  "migrations": []
}
