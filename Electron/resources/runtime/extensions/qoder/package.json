{
  "name": "@pipiui/qoder-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Canonical Qoder / Qoder CN provider (OAuth + PAT) vendored from pi-provider-qoder@0.3.0 with PipiUI context-window compat",
  "exports": {
    "./package.json": "./package.json",
    "./agent/provider": "./agent/dist/provider.js",
    "./agent/host": "./agent/dist/host.js",
    "./agent/models": "./agent/dist/vendor/models.js"
  },
  "scripts": {
    "build": "tsc -p agent/tsconfig.json",
    "postbuild": "node ../../scripts/sync-bundled-extension.mjs qoder-extension",
    "test": "vitest run",
    "clean": "rm -rf agent/dist"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@pipiui/extension-api": "*",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@pipiui/extension-api": "*"
  }
}
