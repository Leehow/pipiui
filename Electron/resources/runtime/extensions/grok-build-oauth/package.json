{
  "name": "@pipiui/grok-build-oauth-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Canonical Grok Build OAuth + conversation models + Image tools (generic extension auth/provider contribution)",
  "exports": {
    "./package.json": "./package.json",
    "./agent/provider": "./agent/dist/provider.js",
    "./agent/host": "./agent/dist/host.js",
    "./agent/models": "./agent/dist/models.js"
  },
  "scripts": {
    "build": "tsc -p agent/tsconfig.json && tsc -p app/tsconfig.json",
    "postbuild": "node ../../scripts/sync-bundled-extension.mjs grok-build-oauth-extension",
    "test": "vitest run",
    "clean": "rm -rf agent/dist app/dist"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@pipiui/extension-api": "*",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@pipiui/extension-api": "*"
  }
}
