{
  "name": "@pipiui/web-search-keys-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web 搜索密钥：按项目写入 web-search.json，密钥永不回传 UI",
  "scripts": {
    "build": "tsc -p app/tsconfig.json",
    "postbuild": "node ../../scripts/sync-bundled-extension.mjs web-search-keys-extension",
    "test": "vitest run",
    "pretest": "npm run build",
    "clean": "rm -rf app/dist"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
