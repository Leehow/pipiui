{
  "name": "pipiui-memory-broker",
  "version": "0.1.0",
  "description": "Loopback-only, host-neutral Pi memory broker extension with bounded worker and operator clients.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pipiui",
    "memory"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./extension": {
      "types": "./extensions/memory-broker.ts",
      "default": "./extensions/memory-broker.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "eval": "node scripts/run-eval.mjs",
    "eval:memory": "node --experimental-strip-types scripts/eval-memory.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "imports": {
    "#memory-broker-contract": "./vendor/pipiui-memory-broker-contract/contract/index.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/memory-broker.ts"
    ]
  },
  "files": [
    "extensions/memory-broker.ts",
    "src/*.ts",
    "ui/**",
    "eval/**",
    "scripts/**",
    "tsconfig.json",
    "types/**",
    "vendor/pipiui-memory-broker-contract/**",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "pipiui-memory-broker-contract": "file:vendor/pipiui-memory-broker-contract",
    "pi-hermes-memory": "0.9.6"
  },
  "bundledDependencies": [
    "pipiui-memory-broker-contract",
    "pi-hermes-memory"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.3"
  }
}
