// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`web-access-extension schema snapshot > extension-mounted schemas are identical to the pinned package and snapshotted > fetch_content schema 1`] = `
{
  "properties": {
    "answerModel": {
      "description": "provider/model-id for answer mode",
      "type": "string",
    },
    "auth": {
      "anyOf": [
        {
          "type": "string",
        },
        {
          "type": "boolean",
        },
      ],
      "description": "authFetch profile name, or true for the only one",
    },
    "forceClone": {
      "description": "Clone GitHub repos over the size limit",
      "type": "boolean",
    },
    "frames": {
      "description": "Frames over a range, 5s apart from one time, or over the video",
      "maximum": 12,
      "minimum": 1,
      "type": "integer",
    },
    "mode": {
      "description": "readable (default): extract readable content as markdown; raw: return the exact textual body using direct HTTP only; answer: answer a prompt using only fetched content.",
      "enum": [
        "readable",
        "raw",
        "answer",
      ],
      "type": "string",
    },
    "model": {
      "description": "Gemini model for video analysis",
      "type": "string",
    },
    "prompt": {
      "description": "Question for video analysis or answer mode",
      "type": "string",
    },
    "proxy": {
      "description": "Proxy URL; omit by default; "" forces direct",
      "type": "string",
    },
    "redirects": {
      "description": "Refuse cross-origin redirects",
      "enum": [
        "same-origin",
      ],
      "type": "string",
    },
    "timestamp": {
      "description": "Video frame time ('1:23:45') or range ('23:41-25:00'); needs ffmpeg",
      "type": "string",
    },
    "url": {
      "type": "string",
    },
    "urls": {
      "items": {
        "type": "string",
      },
      "type": "array",
    },
  },
  "type": "object",
}
`;

exports[`web-access-extension schema snapshot > extension-mounted schemas are identical to the pinned package and snapshotted > get_search_content schema 1`] = `
{
  "properties": {
    "findMode": {
      "enum": [
        "exact",
        "case-insensitive",
        "fuzzy",
      ],
      "type": "string",
    },
    "findText": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 10,
          "minItems": 1,
          "type": "array",
        },
      ],
      "description": "Find passages instead of paging",
    },
    "limit": {
      "description": "Characters, default the maximum",
      "maximum": 30000,
      "minimum": 1,
      "type": "integer",
    },
    "offset": {
      "minimum": 0,
      "type": "integer",
    },
    "query": {
      "type": "string",
    },
    "queryIndex": {
      "minimum": 0,
      "type": "integer",
    },
    "responseId": {
      "type": "string",
    },
    "url": {
      "type": "string",
    },
    "urlIndex": {
      "minimum": 0,
      "type": "integer",
    },
  },
  "required": [
    "responseId",
  ],
  "type": "object",
}
`;

exports[`web-access-extension schema snapshot > extension-mounted schemas are identical to the pinned package and snapshotted > source_check schema 1`] = `
{
  "properties": {
    "claim": {
      "description": "Assertion to check",
      "type": "string",
    },
    "domainFilter": {
      "description": "Prefix - to exclude",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "fetchContent": {
      "description": "Fetch top 5 pages for exact passages",
      "type": "boolean",
    },
    "numResults": {
      "description": "Default 5",
      "maximum": 20,
      "minimum": 1,
      "type": "integer",
    },
    "provider": {
      "description": "auto, all, a name, or comma-separated names; omit for the configured default.",
      "type": "string",
    },
    "proxy": {
      "description": "Proxy URL; omit by default; "" forces direct",
      "type": "string",
    },
    "queries": {
      "description": "Default: the claim",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "recencyFilter": {
      "enum": [
        "day",
        "week",
        "month",
        "year",
      ],
      "type": "string",
    },
  },
  "required": [
    "claim",
  ],
  "type": "object",
}
`;

exports[`web-access-extension schema snapshot > extension-mounted schemas are identical to the pinned package and snapshotted > web_search schema 1`] = `
{
  "properties": {
    "category": {
      "description": "Exa only, e.g. news",
      "type": "string",
    },
    "domainFilter": {
      "description": "Prefix - to exclude",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "includeContent": {
      "description": "Also fetch full page content",
      "type": "boolean",
    },
    "model": {
      "description": "Model ID; needs provider openai, gemini, xai, mistral",
      "type": "string",
    },
    "numResults": {
      "description": "Default 5",
      "maximum": 20,
      "minimum": 1,
      "type": "integer",
    },
    "provider": {
      "description": "auto, all, a name, or comma-separated names; omit for the configured default.",
      "type": "string",
    },
    "proxy": {
      "description": "Proxy URL; omit by default (env proxy vars ignored); "" forces direct",
      "type": "string",
    },
    "queries": {
      "description": "Run concurrently (up to three at a time); vary the angle",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "query": {
      "type": "string",
    },
    "recencyFilter": {
      "enum": [
        "day",
        "week",
        "month",
        "year",
      ],
      "type": "string",
    },
    "workflow": {
      "description": "Default none; summary-review opens the curator; auto-summary summarizes",
      "enum": [
        "none",
        "summary-review",
        "auto-summary",
      ],
      "type": "string",
    },
  },
  "type": "object",
}
`;
