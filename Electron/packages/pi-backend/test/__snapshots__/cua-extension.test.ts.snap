exports[`cua-extension frozen tool schema contract > extension-mounted schemas, labels and descriptions are identical to the legacy strategy > open_application schema 1`] = `
{
  "additionalProperties": false,
  "properties": {
    "application_name": {
      "description": "Human application name, such as TextEdit or Google Chrome.",
      "maxLength": 255,
      "minLength": 1,
      "type": "string",
    },
    "bundle_identifier": {
      "description": "Exact installed macOS bundle identifier, such as com.google.Chrome.",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+$",
      "type": "string",
    },
  },
  "type": "object",
}
`;
