{
  "name": "@pipiui/deepseek-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Canonical DeepSeek Responses provider + hosted web_search (generic extension auth/provider contribution)",
  "exports": {
    "./package.json": "./package.json",
    "./agent/provider": "./agent/dist/provider.js",
    "./agent/host": "./agent/dist/host.js",
    "./agent/models": "./agent/dist/models.js"
  },
  "scripts": {
    "build": "tsc -p agent/tsconfig.json && tsc -p app/tsconfig.json",
    "postbuild": "node scripts/postbuild.mjs",
    "test": "vitest run",
    "clean": "rm -rf agent/dist app/dist"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@pipiui/extension-api": "*",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@pipiui/extension-api": "*"
  }
}
