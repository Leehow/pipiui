# npm's default maxsockets (15) deadlocks behind a local HTTP proxy: the
# connections establish, the proxy drops them without a FIN, and npm then waits
# out fetch-timeout on every one of them. The symptom is an install that burns
# zero CPU and writes nothing for minutes while holding hundreds of ESTABLISHED
# sockets. Three connections is slower in theory and vastly faster in practice
# (a workspace install that hung indefinitely at 15 completed in 7s at 3).
maxsockets=3

# Surface a dead connection in one minute instead of five, so a stall fails
# loudly rather than looking like slow progress.
fetch-timeout=60000
fetch-retries=4
