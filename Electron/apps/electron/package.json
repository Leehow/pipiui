{
  "name": "@pipiui/electron",
  "version": "0.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "description": "pipiui_e — cross-platform PipiUI client",
  "author": {
    "name": "PipiUI",
    "email": "pipiui@leehow.com"
  },
  "homepage": "https://github.com/Leehow/pipiui",
  "scripts": {
    "predev": "node ../../scripts/fetch-pi-runtime.mjs",
    "dev": "electron-vite dev",
    "predev:watch": "node ../../scripts/fetch-pi-runtime.mjs",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build && npm run verify:preload",
    "verify:preload": "node verify-preload.mjs",
    "package": "npm run package:mac",
    "package:mac": "CUA_TARGET_PLATFORM=darwin node ../../scripts/fetch-cua-driver.mjs && node ../../scripts/package-electron-target.mjs --platform darwin --arch x64 -- --mac --x64 && node ../../scripts/package-electron-target.mjs --platform darwin --arch arm64 -- --mac --arm64",
    "package:win": "node ../../scripts/fetch-cua-driver.mjs && node ../../scripts/package-electron-target.mjs --platform win32 --arch x64 -- --win --x64",
    "package:linux": "CUA_TARGET_PLATFORM=linux CUA_TARGET_ARCH=x64 node ../../scripts/fetch-cua-driver.mjs && node ../../scripts/package-electron-target.mjs --platform linux --arch x64 -- --linux --x64"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@file-viewer/vite-plugin": "^2.2.8",
    "@pipi/host-api": "file:../../packages/host-api",
    "@pipi/pi-backend": "file:../../packages/pi-backend",
    "@pipiui/server": "file:../server",
    "@pipiui/ui": "file:../../packages/ui",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.leehow.pipiui-electron",
    "productName": "PipiUI",
    "forceCodeSigning": true,
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/node-pty/**/*",
      "node_modules/@xterm/headless/**/*",
      "node_modules/@xterm/addon-serialize/**/*"
    ],
    "extraResources": [
      {
        "from": "../../.cua-driver/${env.PIPIUI_EMBEDDED_RUNTIME_TARGET}",
        "to": "cua-driver"
      },
      {
        "from": "../../resources/runtime",
        "to": "pipiui-runtime",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo",
          "!**/out/**",
          "!**/dist/**",
          "!**/release/**",
          "!**/target/**",
          "!**/.cua-driver-cache/**",
          "!extensions/office-extension/bin/**/officecli",
          "!extensions/office-extension/bin/**/officecli.exe",
          "!extensions/office-extension/bin/**/receipt.json"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/grok-build-oauth",
        "to": "pipiui-runtime/extensions/grok-build-oauth",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/code-retrieval",
        "to": "pipiui-runtime/extensions/code-retrieval",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo",
          "!**/target/**"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/git-capability",
        "to": "pipiui-runtime/extensions/git-capability",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/deepseek",
        "to": "pipiui-runtime/extensions/deepseek",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/qoder",
        "to": "pipiui-runtime/extensions/qoder",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/pipiui-headroom",
        "to": "pipiui-runtime/extensions/pipiui-headroom",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/vision-routing",
        "to": "pipiui-runtime/extensions/vision-routing",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/web-search-keys",
        "to": "pipiui-runtime/extensions/web-search-keys",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/external-session-scan",
        "to": "pipiui-runtime/extensions/external-session-scan",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/office-extension",
        "to": "pipiui-runtime/extensions/office-extension",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo",
          "!bin/**/officecli",
          "!bin/**/officecli.exe",
          "!bin/**/receipt.json"
        ]
      },
      {
        "from": "../../resources/runtime/extensions/pdf-extension",
        "to": "pipiui-runtime/extensions/pdf-extension",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/*.tsbuildinfo",
          "!vendor/pdf-inspector/node_modules/.bin",
          "!vendor/pdf-inspector/node_modules/.bin/**"
        ]
      },
      {
        "from": "../../.officecli/${env.PIPIUI_EMBEDDED_RUNTIME_TARGET}",
        "to": "pipiui-runtime"
      },
      {
        "from": "../../resources/runtime/anydoc/node_modules",
        "to": "pipiui-runtime/anydoc/node_modules",
        "filter": [
          "**/*",
          "!**/.bin",
          "!**/.bin/**"
        ]
      },
      {
        "from": "../../.embedded-runtimes/${env.PIPIUI_EMBEDDED_RUNTIME_TARGET}",
        "to": "pipiui-embedded"
      },
      {
        "from": "../../packages/ui/dist/browser",
        "to": "browser-ui"
      }
    ],
    "directories": {
      "output": "../../../build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleDisplayName": "PipiUI",
        "CFBundleName": "PipiUI"
      },
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/512x512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "category": "Development",
      "maintainer": "PipiUI <pipiui@leehow.com>",
      "vendor": "PipiUI",
      "executableName": "pipiui_e",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "pipiui_e_${version}_${arch}.${ext}"
    }
  }
}
