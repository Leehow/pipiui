{
  "name": "@pipiui/electron",
  "version": "0.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "description": "pipiui_e — cross-platform PipiUI Electron client",
  "author": {
    "name": "PipiUI",
    "email": "pipiui@leehow.com"
  },
  "homepage": "https://github.com/Leehow/pipiui",
  "scripts": {
    "predev": "node ../../scripts/fetch-pi-runtime.mjs",
    "dev": "electron-vite dev",
    "predev:watch": "node ../../scripts/fetch-pi-runtime.mjs",
    "dev:watch": "electron-vite dev --watch",
    "build": "electron-vite build && npm run verify:preload",
    "verify:preload": "node verify-preload.mjs",
    "package": "npm run package:mac",
    "package:mac": "CUA_TARGET_PLATFORM=darwin node ../../scripts/fetch-cua-driver.mjs && node ../../scripts/package-electron-target.mjs --platform darwin --arch x64 -- --mac --x64 && node ../../scripts/package-electron-target.mjs --platform darwin --arch arm64 -- --mac --arm64",
    "package:win": "node ../../scripts/fetch-cua-driver.mjs && node ../../scripts/package-electron-target.mjs --platform win32 --arch x64 -- --win --x64",
    "package:linux": "node ../../scripts/fetch-cua-driver.mjs && node ../../scripts/package-electron-target.mjs --platform linux --arch x64 -- --linux --x64"
  },
  "dependencies": {
    "@pipi/host-api": "file:../../packages/host-api",
    "@pipi/pi-backend": "file:../../packages/pi-backend",
    "@pipiui/ui": "file:../../packages/ui",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "32.3.3",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.leehow.pipiui-electron",
    "productName": "PipiUI Electron",
    "forceCodeSigning": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../.cua-driver",
        "to": "cua-driver"
      },
      {
        "from": "../../resources/runtime",
        "to": "pipiui-runtime",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/.git/**",
          "!**/*.tsbuildinfo",
          "!**/out/**",
          "!**/dist/**",
          "!**/release/**",
          "!**/.cua-driver-cache/**"
        ]
      },
      {
        "from": "../../.embedded-runtimes/${env.PIPIUI_EMBEDDED_RUNTIME_TARGET}",
        "to": "pipiui-embedded"
      }
    ],
    "directories": {
      "output": "../../../build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "binaries": [
        "Contents/Resources/pipiui-embedded/node/bin/node"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icons/512x512.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icons",
      "category": "Development",
      "maintainer": "PipiUI <pipiui@leehow.com>",
      "vendor": "PipiUI",
      "executableName": "pipiui_e",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "pipiui_e_${version}_${arch}.${ext}"
    }
  }
}
